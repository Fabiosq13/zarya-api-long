{
  "name": "zarya-agent",
  "version": "1.0.0",
  "description": "Agente conversacional de carteira (Fastify + TypeScript + Gemini) que consome a API Zarya",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:web && tsc",
    "build:web": "npm --prefix web install --include=dev && npm --prefix web run build",
    "build:server": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.3.0",
    "@google/genai": "^2.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
