# ===== Zarya =====
# Produção:    https://api.zarya.net.br
# Homologação: https://apishow.zarya.net.br
ZARYA_BASE_URL=https://api.zarya.net.br
# Token CRU (sem URL encode — o código encoda automaticamente)
# Base nova (maior):
ZARYA_TOKEN=9e4b7c21a8f35d60c2e9147b6a83fd52
ZARYA_TIMEOUT_MS=15000

# ===== Gemini =====
GEMINI_API_KEY=coloque-sua-chave-aqui
# gemini-2.5-flash (estável/barato) ou gemini-3.5-flash (mais novo)
GEMINI_MODEL=gemini-2.5-flash

# ===== App =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CACHE_TTL_SECONDS=900
RATE_LIMIT_MAX=60
LOG_LEVEL=info
# CORS: origens permitidas (separadas por vírgula) ou "*" para liberar todas.
CORS_ORIGIN=*

# ===== Portfólio =====
# Data padrão genérica (último recurso).
PORTFOLIO_DEFAULT_DATE=2026-02-02
# Data padrão por modo na base nova (referências diferentes por visão):
#   Ativos/Carteira envia MM/DD/YYYY  -> 01/27/2026
#   Passivo/Cotista envia MM-DD-YYYY  -> 02-02-2026
PORTFOLIO_DEFAULT_DATE_ATIVOS=2026-01-27
PORTFOLIO_DEFAULT_DATE_PASSIVOS=2026-02-02
# Quantos dias andar para trás procurando uma data com posições.
PORTFOLIO_LOOKBACK_DAYS=7

# ===== Conversas (Redis) =====
# No Railway: adicione o plugin Redis e a REDIS_URL é injetada automaticamente.
# Local: deixe em branco para usar memória, ou aponte para um Redis local.
REDIS_URL=
CONVERSATION_TTL_SECONDS=604800
CONVERSATION_MAX_TURNS=20

# --- Autenticação (usuário único, sem banco) ---
AUTH_EMAIL=master.zarya
AUTH_PASSWORD='Zar$#2026*'
# Troque por um valor longo e aleatório em produção:
AUTH_SECRET=troque-este-segredo-em-producao
AUTH_TOKEN_TTL_HOURS=12
